SECRET_KEY=your-secret-key-here
# DEBUG=True is for local development ONLY. Any real/public deployment must set DEBUG=False
# (the app already refuses to boot with DEBUG=False and the placeholder SECRET_KEY above,
# but nothing stops DEBUG itself from being left True by mistake — double-check this value).
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Production example (Render + subdomain):
# DEBUG=False
# ALLOWED_HOSTS=shop.yourdomain.com,your-app.onrender.com
# CSRF_TRUSTED_ORIGINS=https://shop.yourdomain.com,https://your-app.onrender.com
# DATABASE_URL=postgres://...  (set automatically on Render)

# Tamara (Buy Now, Pay Later) — from Tamara Partners Portal, after your
# merchant application is approved. Leave blank to disable Tamara at checkout.
TAMARA_API_TOKEN=your_tamara_api_token
TAMARA_NOTIFICATION_TOKEN=your_tamara_notification_token
TAMARA_PUBLIC_KEY=your_tamara_public_key
# Switch to https://api.tamara.co once you're ready for real transactions.
TAMARA_API_BASE_URL="https://api-sandbox.tamara.co"
TAMARA_COUNTRY_CODE="AE"

TABBY_PUBLIC_KEY=""
TABBY_SECRET_KEY=""
TABBY_MERCHANT_CODE="AE"
TABBY_API_BASE_URL="https://api.tabby.ai"

# Tap Payments (cards, Apple Pay, mada, etc.) — from the Tap Business
# Dashboard (business.tap.company) under Developers > API Keys. Leave blank
# to disable Tap at checkout. Use the sk_test_/pk_test_ keys until you're
# ready for real transactions, then switch to the live sk_live_/pk_live_ keys.
TAP_SECRET_KEY=""
TAP_PUBLIC_KEY=""
TAP_API_BASE_URL="https://api.tap.company/v2"

# Nomod Hosted Checkout — the online payment option at checkout. Cards,
# Apple Pay, Google Pay, Tabby and Tamara all appear on Nomod's hosted page
# (enable each under Payment Method settings in the Nomod dashboard).
# From Nomod: Settings > Tools & Customisations > Apps & APIs.
#   NOMOD_API_KEY        — Nomod Hosted Checkout API key (sk_test_... to test, live key for real payments)
#   NOMOD_WEBHOOK_SECRET — Webhooks > your endpoint's Signing secret (whsec_...)
# Webhook endpoint to register in Nomod: https://www.elvessora.ae/orders/payment/nomod/webhook/
# Leave NOMOD_API_KEY blank to hide online payment (Cash on Delivery only).
NOMOD_API_KEY=""
NOMOD_WEBHOOK_SECRET=""
NOMOD_API_BASE_URL="https://api.nomod.com"

# Century Express courier — username/password from Century Express (UAT
# credentials first; production ones after UAT sign-off). Leave blank to turn
# the integration off. CENTURY_AUTO_BOOK=True books each order with Century
# the moment it's confirmed; set False to book from the order admin instead.
CENTURY_USERNAME=""
CENTURY_PASSWORD=""
CENTURY_API_BASE_URL="https://mobi.centuryexpress.me:9094/Ablii_Century_API_Int/"
CENTURY_AUTO_BOOK="True"
CENTURY_ITEM_WEIGHT_KG="0.5"

AMAZON_SP_API_REFRESH_TOKEN=""
AMAZON_SP_API_LWA_CLIENT_ID=""
AMAZON_SP_API_LWA_CLIENT_SECRET=""

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

WHATSAPP_NUMBER=971508728042

# Meta WhatsApp Cloud API — sends automated order/account notifications to
# customers who opt in. Leave blank to disable (emails still send as normal).
# Get these from a Meta Business app with the WhatsApp product added:
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-business-phone-number-id
WHATSAPP_API_VERSION=v20.0
# Business-initiated messages require a pre-approved message template.
# Create one (e.g. a single {{1}}-variable body) in Meta Business Manager,
# then set its exact name here. Until this is set, sends fall back to
# free-form text, which WhatsApp only delivers inside a live 24h chat window.
WHATSAPP_NOTIFICATION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Google Sign-In (OAuth 2.0 Web client from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/accounts/google/callback/
# In Google Console → Clients → your Web client, add that exact redirect URI.
